# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Unica MaxAI orchestrator API ---
MAXAI_API_URL=https://unicatango.hxun.now.hclsoftware.cloud/maxai/orchestrator/v1/query/form
MAXAI_USERNAME=
MAXAI_PASSWORD=
MAXAI_TIMEOUT_SECONDS=30

# --- Auth chain: platform token -> MaxAI login -> orchestrator query ---
# Both default to the host derived from MAXAI_API_URL.
MAXAI_TOKEN_URL=
MAXAI_LOGIN_URL=
# Optional: reuse a known m_tokenId instead of calling the token endpoint.
MAXAI_TOKEN_ID=
MAXAI_SSO_DESTAPP=AION
MAXAI_AUTH_MODE=manager

# --- Local LLM judge (any OpenAI-compatible server) ---
LLM_MODEL=qwen3:14b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.0

# --- Metric thresholds (all optional, defaults shown) ---
THRESH_CONTEXTUAL_PRECISION=0.7
THRESH_CONTEXTUAL_RECALL=0.7
THRESH_CONTEXTUAL_RELEVANCY=0.7
THRESH_FAITHFULNESS=0.7
THRESH_ANSWER_RELEVANCY=0.7
# Hallucination: DeepEval scores factual alignment with the context,
# so HIGHER is better and this is the MINIMUM required score.
THRESH_HALLUCINATION=0.8
THRESH_CORRECTNESS=0.7
