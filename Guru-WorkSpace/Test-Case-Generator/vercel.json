{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install --prefix .. && npm install"
    }
  },
  "functions": {
    "api/generate.js":       { "maxDuration": 60, "memory": 1024 },
    "api/download-excel.js": { "maxDuration": 30, "memory": 512  },
    "api/fetch-jira.js":     { "maxDuration": 20, "memory": 256  }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
