    {
      "id": "1338109",
      "author": "Su Su",
      "created": "2026-06-01T08:16:49.132-0400",
      "updated": "2026-06-01T08:16:49.132-0400",
      "body": {
        "type": "doc",
        "version": 1,
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "mention",
                "attrs": {
                  "id": "712020:694f8462-b908-4edc-ab75-5ae8c7e6ff80",
                  "text": "@Sachin Bansal",
                  "accessLevel": ""
                }
              },
              {
                "type": "text",
                "text": " "
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "For this edge case: "
              }
            ]
          },
          {
            "type": "table",
            "attrs": {
              "isNumberColumnEnabled": false,
              "layout": "center",
              "localId": "c9b9ab57-a989-4684-b04b-c9b4f72351d2"
            },
            "content": [
              {
                "type": "tableRow",
                "content": [
                  {
                    "type": "tableCell",
                    "attrs": {},
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Tied acceptance rates"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "tableCell",
                    "attrs": {},
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Select the branch with higher total contacts (more data confidence); if still tied, select first"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Select the branch configured with higher percentage. If this is still a tie, select the first."
              }
            ]
          },
          {
            "type": "paragraph"
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Additionally, we can add 2 more settings"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "order": 1
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Reevaluation interval - the frequency to re-evaluate the acceptance rate and hence select the winning branch"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Recent transaction weight (0 to 1.0) - the weight of the acceptance rate during the last evaluation interval: overall acceptance rate = weight x (acceptance rate in the last interval) + (1.0 - weight) x (acceptance rate before the last interval)"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "In UACI_ABTest, instead of adding 2 columns, create a text column “OtherSettings” for all the new settings in the format of JSON."
              }
            ]
          }
        ]
      }
    },
    {
